{
  "output_dir": "outputs",
  "pos_model": "artifacts/pos_segmentation_model",
  "llm": {"model": "gpt-5-mini", "batch_size": 100, "workers": 5},
  "hybrid_threshold": 0.1,
  "fallback": {
    "boundary_penalty": 0.35,
    "abbr_log_priors": {"2": -9.25, "3": -9.75, "4": -10.5, "5": -11.25},
    "low_vowel_ratio": 0.34,
    "low_vowel_bonus": 0.35,
    "no_vowel_bonus": 0.75,
    "edit_penalty": 2.5,
    "accept_margin": 1.0,
    "segment_reduction_margin": 2.0,
    "min_fuzzy_length": 5,
    "max_fuzzy_candidates": 12,
    "min_candidate_count": 10,
    "max_known_count_for_fuzzy": 250000.0
  },
  "datasets": {
    "synthetic": {
      "input": "data/synthetic/domains.csv",
      "llm_cache": "data/llm/synthetic.csv",
      "rows": {"viterbi": 100000, "fallback": 100000, "vbe": 100000, "pos": 1000, "gpt": 10000, "hybrid": 10000}
    },
    "human": {
      "input": "data/manual/human_domains.csv",
      "llm_cache": "data/llm/human.csv",
      "rows": {"viterbi": 2000, "fallback": 2000, "vbe": 2000, "pos": 2000, "gpt": 2000, "hybrid": 2000}
    }
  }
}
